# Points the built UI at the backend. Same-origin by default (works behind the dev proxy and docker).
# Example for split hosting: VITE_API_URL=https://api.socforensics.io
VITE_API_URL=https://emailscanner-production-e5ad.up.railway.app
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Dev only: where /api is proxied when running `npm run dev`.
# VITE_PROXY_TARGET=http://localhost:8000
# Custom domain (production): set via DNS CNAME + nginx server_name.
# See frontend/public/CNAME (socforensics.io) and frontend/nginx.conf.
# Canonical base used for SEO: https://socforensics.io — change in index.html + vite if forking.
