# NOTE: this file is a REFERENCE, not the file Vite reads.
#
# `vite.config.ts` sets `envDir: '..'`, so the frontend loads the REPO-ROOT
# `.env` — the same single file the backend and docker-compose use. Put your
# values there. This file only documents which keys the frontend cares about.
#
# Only VITE_-prefixed keys reach the browser bundle; the server secrets in that
# shared file (SECRET_KEY, DATABASE_URL, SUPABASE_JWT_SECRET, ...) are not
# shipped to the client.

# --- LOCAL DEVELOPMENT ---
# Leave VITE_API_URL EMPTY. The Vite dev server (npm run dev) proxies /api and
# /health to VITE_PROXY_TARGET, so the browser calls its own origin and CORS
# never applies. Filling this in points your local UI at a deployed backend
# instead, which then needs http://localhost:5173 in its CORS_ORIGINS.
VITE_API_URL=
# Where /api is proxied during `npm run dev`.
VITE_PROXY_TARGET=http://localhost:8000
# Required in all environments: Supabase owns authentication. Supabase →
# Settings → API. These are the public project URL and anon key; they are safe
# to expose to the browser and are not the service-role key.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- OFFLINE DEV LOGIN (LOCAL DEV ONLY — never in a deployed frontend) ---
# No dev tokens or passwords are hard-coded in src/auth.tsx. When Supabase is
# completely unconfigured, `npm run dev` may use these throwaway credentials
# instead. All five must be present, and the fallback additionally requires a
# dev build, so a production build never honors them even if baked in.
# The password is always verified — a username alone never authenticates.
# NEVER set VITE_ALLOW_DEV_AUTH=1 on Vercel / any deployed frontend.
# VITE_ALLOW_DEV_AUTH=1
# VITE_DEV_ADMIN_TOKEN=
# VITE_DEV_ADMIN_PASSWORD=
# VITE_DEV_ANALYST_TOKEN=
# VITE_DEV_ANALYST_PASSWORD=

# --- SPLIT / PRODUCTION HOSTING ---
# For Vercel + Railway, set VITE_API_URL to the backend origin with no trailing
# slash, e.g. https://emailscanner-production-0199.up.railway.app. Vite bakes
# VITE_* values in at BUILD time, so changing this requires a Vercel rebuild,
# not just a redeploy.
# Production frontend: https://email-scanner-chi.vercel.app (Vercel).
# Canonical base used for SEO lives in frontend/index.html + frontend/src
# (CANONICAL_BASE) — change it there if forking under a new domain.
