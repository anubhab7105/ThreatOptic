# Copy to .env (backend/) and to the repo root as .env for `docker compose`.
# NEVER commit a filled-in copy — all *_PASSWORD / *_KEY values are secrets.
DATABASE_URL=sqlite:///./email_forensics.db
# --- Supabase (production) ---
# Supabase → Settings → Database → Connection string → URI → Connection pooling (6543)
# Example: postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Paste that full URI as DATABASE_URL in Railway (Railway will inject it automatically if you use Supabase as external DB).
# The app normalizes `postgres://` and `postgresql://` to `postgresql+psycopg2://` automatically.
# SUPABASE_DATABASE_URL=postgresql://postgres.xxxxx:pass@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# --- Postgres (compose - local docker) ---
POSTGRES_USER=soc
POSTGRES_PASSWORD=
POSTGRES_DB=soc
# --- Graph (F8: required when running >1 backend replica) ---
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
EXPECTED_REPLICAS=1
# --- Elasticsearch full-text mirror (F10; empty URL = SQLite fallback) ---
ELASTICSEARCH_URL=
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
KAFKA_BOOTSTRAP=
# Ingest queue bounds (P0): item count AND byte budget. Kafka is an opt-in
# MIRROR for external consumers only — the pipeline consumes the memory
# queue, which cannot survive a restart (documented in queue.py).
# SMTP_QUEUE_MAX=1000
# SMTP_QUEUE_MAX_BYTES=104857600
VIRUSTOTAL_API_KEY=
MISP_URL=
MISP_KEY=
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
# Auth: SECRET_KEY (JWT HMAC) MUST be 32+ random chars in any non-dev
# deployment — the app refuses to boot otherwise. Access tokens live 20 min.
SECRET_KEY=
# APP_ENV defaults to production-safe posture; set development for local dev.
APP_ENV=development
# Out-of-band bootstrap secret: required to create an Admin via
# POST /auth/register (no first-registrant bootstrap exists).
SETUP_TOKEN=
# Mailbox-token vault key (PBKDF2, min 32 chars) — fail-closed when empty.
TOKEN_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173
# Chain-of-custody signing: provision from a secrets manager in prod.
# Previous key accepted during rotation windows only.
CUSTODY_KEY=
CUSTODY_KEY_PREVIOUS=
# Model integrity (P0): Ed25519 public key (64 hex chars) that production
# model loads verify against (<artifact>.sig). Generate + sign offline:
#   python backend/scripts/sign_model.py --keygen
#   MODEL_SIGN_KEY=<seed> python backend/scripts/sign_model.py backend/ml_models/phishing_clf.joblib
# Without it, loads fall back to .sha256 sidecars; with neither, production
# refuses to unpickle. Never set MODEL_TRUST_INSECURE=1 outside local dev.
MODEL_VERIFY_KEY=
# MODEL_TRUST_INSECURE=1
# Optional transformer rerank (dev only): model + PINNED 40-char revision.
# Production refuses unpinned transformers (falls back to sklearn).
# TRANSFORMERS_MODEL=
# TRANSFORMERS_REVISION=
# Inline SMTP relay (F3): SMTP_ENABLED=1 to listen
SMTP_ENABLED=0
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Gmail OAuth2 connector (server-side only; secrets never accepted per-request)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/
# Organization mailbox connectors (F7)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173
# Extra allowed OAuth redirect URIs (comma-separated) beyond FRONTEND_URL/GOOGLE_REDIRECT_URI
OAUTH_REDIRECT_ALLOWLIST=
MAIL_POLL_MINUTES=0
# 0 = fast offline enrichment (default); 1 = live ip-api/WHOIS/DNS/DNSBL/URLhaus
ENABLE_LIVE_LOOKUPS=0
RETENTION_HOUR=3
