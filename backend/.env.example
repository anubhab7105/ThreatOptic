# Copy to .env (backend/) and to the repo root as .env for `docker compose`.
# NEVER commit a filled-in copy — all *_PASSWORD / *_KEY values are secrets.
DATABASE_URL=sqlite:///./email_forensics.db
# --- Postgres (compose) ---
POSTGRES_USER=soc
POSTGRES_PASSWORD=
POSTGRES_DB=soc
# --- Graph (F8: required when running >1 backend replica) ---
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
EXPECTED_REPLICAS=1
# --- Elasticsearch full-text mirror (F10; empty URL = SQLite fallback) ---
ELASTICSEARCH_URL=
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
KAFKA_BOOTSTRAP=
VIRUSTOTAL_API_KEY=
MISP_URL=
MISP_KEY=
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
# Auth (change in prod; HMAC min 32 bytes recommended for JWT secret)
SECRET_KEY=change-me-in-prod
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
# Chain-of-custody signing: provision from a secrets manager in prod
CUSTODY_KEY=
# Inline SMTP relay (F3): SMTP_ENABLED=1 to listen
SMTP_ENABLED=0
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Gmail OAuth2 demo connector (optional; also accepted per-request in the UI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/
# Organization mailbox connectors (F7)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173
MAIL_POLL_MINUTES=0
TOKEN_ENCRYPTION_KEY=
# 0 = fast offline enrichment (default); 1 = live ip-api/WHOIS/DNS/DNSBL/URLhaus
ENABLE_LIVE_LOOKUPS=0
RETENTION_HOUR=3
