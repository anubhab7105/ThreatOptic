# NOTE: this file is a REFERENCE, not the file Vite reads.
#
# `vite.config.ts` sets `envDir: '..'`, so the frontend loads the REPO-ROOT
# `.env` — the same single file the backend and docker-compose use. Put your
# values there. This file only documents which keys the frontend cares about.
#
# Only VITE_-prefixed keys reach the browser bundle; the server secrets in that
# shared file (SECRET_KEY, DATABASE_URL, SUPABASE_JWT_SECRET, ...) are not
# shipped to the client.

# --- LOCAL DEVELOPMENT ---
# Leave VITE_API_URL EMPTY. The Vite dev server (npm run dev) proxies /api and
# /health to VITE_PROXY_TARGET, so the browser calls its own origin and CORS
# never applies. Filling this in points your local UI at a deployed backend
# instead, which then needs http://localhost:5173 in its CORS_ORIGINS.
VITE_API_URL=
# Where /api is proxied during `npm run dev`.
VITE_PROXY_TARGET=http://localhost:8000
# Required in all environments: Supabase owns authentication. Supabase →
# Settings → API. These are the public project URL and anon key; they are safe
# to expose to the browser and are not the service-role key.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- SPLIT / PRODUCTION HOSTING ---
# For Vercel + Railway, set VITE_API_URL to the backend origin with no trailing
# slash, e.g. https://api.socforensics.io. Vite bakes VITE_* values in at BUILD
# time, so changing this requires a Vercel rebuild, not just a redeploy.
# Custom domain (production): set via DNS CNAME + nginx server_name.
# See frontend/public/CNAME (socforensics.io) and frontend/nginx.conf.
# Canonical base used for SEO: https://socforensics.io — change in index.html + vite if forking.
