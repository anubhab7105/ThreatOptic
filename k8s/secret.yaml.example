# Template only — NEVER commit real values here.
# Create the real secret with:
#   kubectl create secret generic soc-secrets \
#     --from-literal=database-url='postgresql+psycopg2://USER:PASS@postgres:5432/soc' \
#     --from-literal=neo4j-uri='bolt://neo4j:7687' \
#     --from-literal=neo4j-user='neo4j' \
#     --from-literal=neo4j-password='<CHANGEME>' \
#     --from-literal=secret-key='<CHANGEME min 32 random bytes>' \
#     --from-literal=custody-key='<CHANGEME min 32 random bytes>'
# (This file is intentionally NOT named secret.yaml so it is never applied
# or mistaken for a live secret.)
apiVersion: v1
kind: Secret
metadata:
  name: soc-secrets-EXAMPLE-DO-NOT-APPLY
type: Opaque
stringData:
  database-url: CHANGEME
  neo4j-uri: CHANGEME
  neo4j-user: CHANGEME
  neo4j-password: CHANGEME
  secret-key: CHANGEME
  custody-key: CHANGEME
